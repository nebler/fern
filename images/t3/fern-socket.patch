+        try: (signal) => new Promise<void>((resolve, reject) => {
+          const req = NodeHttp.request({
+            socketPath: options.socketPath,
+            path: `/envs/${env}/snapshots`, method: "POST", signal,
+            headers: { "content-type": "application/json" },
+          }, (res) => {
+            let error = "";
+            res.setEncoding("utf8");
+            res.on("data", (chunk: string) => { error += chunk.slice(0, 4096 - error.length); });
+            res.on("error", reject);
+            res.on("end", () => {
+              const status = res.statusCode ?? 500;
+              if (status >= 200 && status < 300) resolve();
+              else reject(new Error(`fern snapshot: HTTP ${status}: ${error}`));
+            });
+          });
+          req.on("error", reject);
+          req.end(JSON.stringify({ id, replace: true }));
+        }),
+        catch: (cause) => cause,
+      }).pipe(Effect.timeout(FERN_TIMEOUT_MS)));
+    };

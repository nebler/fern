+/**
+ * Sends the committed files of the project at workspaceRoot, as a new worktree has them, to
+ * Fern, which builds the project's golden snapshot from them: its services' data made once
+ * (such as a database's initdb and seed), which every worktree starts from. Sent when the
+ * project is added, the first thread starts from it too, rather than making that data itself.
+ * Only an optimization, so a failure (no commit yet, no daemon) is logged, never returned.
+ */
+export const prebuildGolden = (workspaceRoot: string, options: PrewakeOptions = {}) => {
+  const pool = "pool" in options ? options.pool : process.env.FERN_POOL?.trim();
+  if (!pool) return Effect.void;
+  const socketPath = options.socketPath ?? FERN_SOCKET;
+  // T3 names a project's worktrees' folder after its checkout's, and so does Fern its goldens.
+  const repo = NodePath.basename(NodePath.resolve(workspaceRoot));
+  const path = `/goldens/${encodeURIComponent(repo)}`;
+  return Effect.tryPromise({
+    try: (signal) => new Promise<void>((resolve, reject) => {
+      const req = NodeHttp.request({
+        socketPath, path, method: "PUT", signal, headers: { "content-type": "application/x-tar" },
+      }, answer(path, resolve, reject));
+      req.on("error", reject);
+      const git = NodeChildProcess.spawn("git", ["archive", "--format=tar", "HEAD"], {
+        cwd: workspaceRoot, signal, stdio: ["ignore", "pipe", "ignore"],
+      });
+      git.on("error", (error) => req.destroy(error));
+      // The tar ends only if git succeeded: a cut one is refused, not built.
+      git.stdout.pipe(req, { end: false });
+      git.on("close", (code) => {
+        if (code === 0) req.end();
+        else req.destroy(new Error(`git archive: exit ${code}`));
+      });
+    }),
+    catch: (cause) => new FernApiError({ path, cause }),
+  }).pipe(
+    Effect.timeout(PREBUILD_TIMEOUT_MS),
+    Effect.catch((cause) =>
+      Effect.logDebug("FernCheckpointStore: Fern couldn't build ahead", { workspaceRoot, cause }),
+    ),
+  );
+};

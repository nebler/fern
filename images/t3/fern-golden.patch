+// Settles a request to path: resolves on a 2xx answer, rejects with the answer's start otherwise.
+const answer = (path: string, resolve: () => void, reject: (error: unknown) => void) =>
+  (res: NodeHttp.IncomingMessage) => {
+    let error = "";
+    res.setEncoding("utf8");
+    res.on("data", (chunk: string) => { error += chunk.slice(0, 4096 - error.length); });
+    res.on("error", reject);
+    res.on("end", () => {
+      const status = res.statusCode ?? 500;
+      if (status >= 200 && status < 300) resolve();
+      else reject(new Error(`fern ${path}: HTTP ${status}: ${error}`));
+    });
+  };

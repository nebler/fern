+          workspaceRoot: `/work/${name}`,
+        });
+      const before = process.env.FERN_POOL;
+      yield* Effect.acquireUseRelease(
+        Effect.sync(() => {
+          delete process.env.FERN_POOL;
+        }),
+        () =>
+          Effect.gen(function* () {
+            yield* create("elsewhere");
+            process.env.FERN_POOL = "/var/lib/fern";
+            yield* create("on-fern");
+          }),
+        () =>
+          Effect.sync(() => {
+            if (before === undefined) delete process.env.FERN_POOL;

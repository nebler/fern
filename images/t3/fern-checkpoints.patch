index 00000000..a4a71528
--- /dev/null
+++ b/apps/server/src/checkpointing/FernCheckpointStore.test.ts
@@ -0,0 +1,175 @@
+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodePath from "node:path";
+
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { it } from "@effect/vitest";
+import { ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import { describe, expect } from "vite-plus/test";
+
+import { checkpointRefForThreadTurn } from "./Utils.ts";
+import * as FernCheckpointStore from "./FernCheckpointStore.ts";
+import * as VcsDriverRegistry from "../vcs/VcsDriverRegistry.ts";
+import * as VcsProcess from "../vcs/VcsProcess.ts";
+
+const layerVcsProcessTest = VcsProcess.layer.pipe(Layer.provide(NodeServices.layer));
+const layerTest = VcsDriverRegistry.layer.pipe(
+  Layer.provideMerge(layerVcsProcessTest),
+  Layer.provideMerge(NodeServices.layer),
+);
+
+const threadId = ThreadId.make("thread-fern-checkpoint-store");
+const ref0 = checkpointRefForThreadTurn(threadId, 0);
+const ref1 = checkpointRefForThreadTurn(threadId, 1);
+
+const run = (cwd: string, args: ReadonlyArray<string>) =>
+  Effect.gen(function* () {
+    const vcsProcess = yield* VcsProcess.VcsProcess;
+    yield* vcsProcess.run({ operation: "FernCheckpointStore.test", command: "git", cwd, args });
+  });
+
+/**
+ * A pool with one git worktree, and a fake fern CLI that logs its arguments. On restore it also
+ * logs README.md as Fern finds it; `which` finds an environment once `known` exists.
+ */
+const setUp = Effect.gen(function* () {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const tmp = yield* fileSystem.makeTempDirectoryScoped({ prefix: "fern-checkpoint-store-" });
+  const pool = NodePath.join(tmp, "pool");
+  const workspace = NodePath.join(pool, "worktrees", "repo", "feature");
+  const log = NodePath.join(tmp, "fern.log");
+  const command = NodePath.join(tmp, "fern");
+  yield* fileSystem.makeDirectory(workspace, { recursive: true });
+  yield* fileSystem.writeFileString(log, "");
+  yield* fileSystem.writeFileString(
+    command,
+    [
+      "#!/bin/sh",
+      `echo "$*" >> '${log}'`,
+      `[ "$1" = restore ] && echo "saw $(cat '${workspace}/README.md')" >> '${log}'`,
+      `[ "$1" = which ] && { [ -e '${tmp}/known' ] || exit 1; echo t3-found; }`,
+      "exit 0",
+      "",
+    ].join("\n"),
+  );
+  yield* fileSystem.chmod(command, 0o755);
+  yield* run(workspace, ["init"]);
+  yield* run(workspace, ["config", "user.email", "test@test.com"]);
+  yield* run(workspace, ["config", "user.name", "Test"]);
+  yield* fileSystem.writeFileString(NodePath.join(workspace, "README.md"), "# test\n");
+  yield* run(workspace, ["add", "."]);
+  yield* run(workspace, ["commit", "-m", "initial commit"]);
+
+  const store = yield* FernCheckpointStore.make({ pool, command });
+  const env = FernCheckpointStore.fernEnvironmentId(workspace);
+  const calls = Effect.map(fileSystem.readFileString(log), (text) =>
+    text.split("\n").filter((line) => line !== ""),
+  );
+  return { fileSystem, tmp, workspace, store, env, calls };
+});
+
+it.layer(layerTest)("FernCheckpointStore", (it) => {
+  describe("captureCheckpoint", () => {
+    it.effect("adopts the worktree once, then snapshots it with every checkpoint", () =>
+      Effect.gen(function* () {
+        const { workspace, store, env, calls } = yield* setUp;
+
+        yield* store.captureCheckpoint({ cwd: workspace, checkpointRef: ref0 });
+        yield* store.captureCheckpoint({
+          cwd: NodePath.join(workspace, "."),
+          checkpointRef: ref1,
+        });
+
+        expect(yield* store.hasCheckpointRef({ cwd: workspace, checkpointRef: ref1 })).toBe(true);
+        expect(yield* calls).toEqual([
+          `create --path ${workspace} ${env}`,
+          `snapshot --replace ${env} ${FernCheckpointStore.fernSnapshotId(ref0)}`,
+          `snapshot --replace ${env} ${FernCheckpointStore.fernSnapshotId(ref1)}`,
+        ]);
+      }),
+    );
+
+    it.effect("uses the worktree's environment for a folder inside it", () =>
+      Effect.gen(function* () {
+        const { fileSystem, workspace, store, env, calls } = yield* setUp;
+        const nested = NodePath.join(workspace, "packages", "app");
+        yield* fileSystem.makeDirectory(nested, { recursive: true });
+
+        yield* store.captureCheckpoint({ cwd: nested, checkpointRef: ref0 });
+
+        expect((yield* calls)[0]).toBe(`create --path ${workspace} ${env}`);
+      }),
+    );
+
+    it.effect("leaves folders outside the pool's worktrees to git", () =>
+      Effect.gen(function* () {
+        const { fileSystem, tmp, store, calls } = yield* setUp;
+        const cwd = NodePath.join(tmp, "project");
+        yield* fileSystem.makeDirectory(cwd);
+        yield* run(cwd, ["init"]);
+
+        yield* store.captureCheckpoint({ cwd, checkpointRef: ref0 });
+        yield* store.restoreCheckpoint({ cwd, checkpointRef: ref0 });
+        yield* store.deleteCheckpointRefs({ cwd, checkpointRefs: [ref0] });
+
+        expect(yield* calls).toEqual([]);
+      }),
+    );
+  });
+
+  describe("restoreCheckpoint", () => {
+    it.effect("restores Fern's snapshot before git restores the files and index", () =>
+      Effect.gen(function* () {
+        const { fileSystem, workspace, store, env, calls } = yield* setUp;
+        const readme = NodePath.join(workspace, "README.md");
+        yield* store.captureCheckpoint({ cwd: workspace, checkpointRef: ref0 });
+        yield* fileSystem.writeFileString(readme, "# changed\n");
+
+        expect(yield* store.restoreCheckpoint({ cwd: workspace, checkpointRef: ref0 })).toBe(true);
+
+        expect((yield* calls).slice(2)).toEqual([
+          `restore ${env} ${FernCheckpointStore.fernSnapshotId(ref0)}`,
+          "saw # changed",
+        ]);
+        expect(yield* fileSystem.readFileString(readme)).toBe("# test\n");
+      }),
+    );
+
+    it.effect("doesn't ask Fern for a checkpoint git doesn't have", () =>
+      Effect.gen(function* () {
+        const { workspace, store, calls } = yield* setUp;
+
+        expect(yield* store.restoreCheckpoint({ cwd: workspace, checkpointRef: ref0 })).toBe(false);
+        expect(yield* calls).toEqual([]);
+      }),
+    );
+  });
+
+  describe("deleteCheckpointRefs", () => {
+    it.effect("deletes the snapshots of the worktree's environment", () =>
+      Effect.gen(function* () {
+        const { fileSystem, tmp, workspace, store, calls } = yield* setUp;
+        yield* fileSystem.writeFileString(NodePath.join(tmp, "known"), "");
+
+        yield* store.deleteCheckpointRefs({ cwd: workspace, checkpointRefs: [ref0, ref1] });
+
+        expect(yield* calls).toEqual([
+          `which ${workspace}`,
+          `rmsnap t3-found ${FernCheckpointStore.fernSnapshotId(ref0)} ${FernCheckpointStore.fernSnapshotId(ref1)}`,
+        ]);
+      }),
+    );
+
+    it.effect("does nothing in Fern for a worktree it has no environment for", () =>
+      Effect.gen(function* () {
+        const { workspace, store, calls } = yield* setUp;
+
+        yield* store.deleteCheckpointRefs({ cwd: workspace, checkpointRefs: [ref0] });
+
+        expect(yield* calls).toEqual([`which ${workspace}`]);
+      }),
+    );
+  });
+});

index 00000000..75ff5831
--- /dev/null
+++ b/apps/server/src/checkpointing/FernCheckpointStore.ts
@@ -0,0 +1,158 @@
+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodeCrypto from "node:crypto";
+import * as NodePath from "node:path";
+
+import type { CheckpointRef } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+
+import * as CheckpointStore from "./CheckpointStore.ts";
+import * as VcsProcess from "../vcs/VcsProcess.ts";
+
+/**
+ * Fern keeps a worktree's whole disk with each checkpoint:
+ * ignored files, dependencies and running databases, which git checkpoints leave behind. A
+ * worktree at `<pool>/worktrees/<repo>/<name>` is a Fern environment, and every checkpoint there
+ * is also a Fern snapshot. Git checkpoints still run, so diffs work as before.
+ */
+export interface FernOptions {
+  /** Fern's pool. T3's worktrees directory must be `<pool>/worktrees`. */
+  readonly pool: string;
+  /** The fern CLI, which talks to the daemon on this node. */
+  readonly command: string;
+}
+
+// A restore stops the environment's box before it swaps the disk.
+const FERN_TIMEOUT_MS = 120_000;
+
+const digest = (value: string, length: number) =>
+  NodeCrypto.createHash("sha256").update(value).digest("hex").slice(0, length);
+
+/** The environment that holds a worktree; the same path always gives the same ID. */
+export const fernEnvironmentId = (workspace: string) => `t3-${digest(workspace, 16)}`;
+
+/** Refs can be longer and use more characters than snapshot IDs allow. */
+export const fernSnapshotId = (ref: CheckpointRef) => `t3-${digest(ref, 32)}`;
+
+export const make = (options: FernOptions) =>
+  Effect.gen(function* () {
+    const git = yield* CheckpointStore.make;
+    const vcsProcess = yield* VcsProcess.VcsProcess;
+    const worktrees = NodePath.join(options.pool, "worktrees");
+    // Creating an environment that exists is a no-op, but it would cost a process per capture.
+    const created = new Set<string>();
+
+    // The worktree holding cwd, or null for folders Fern doesn't manage.
+    const workspaceOf = (cwd: string) => {
+      const parts = NodePath.relative(worktrees, NodePath.resolve(cwd)).split(NodePath.sep);
+      if (parts.length < 2 || parts[0] === ".." || NodePath.isAbsolute(parts[0] ?? "")) {
+        return null;
+      }
+      return NodePath.join(worktrees, parts[0]!, parts[1]!);
+    };
+
+    const fern = (
+      operation: string,
+      cwd: string,
+      args: ReadonlyArray<string>,
+      allowNonZeroExit = false,
+    ) =>
+      vcsProcess.run({
+        operation,
+        command: options.command,
+        args,
+        cwd,
+        // A restore swaps the worktree's directory; fern must not be holding it.
+        spawnCwd: "/",
+        timeoutMs: FERN_TIMEOUT_MS,
+        allowNonZeroExit,
+      });
+
+    const captureCheckpoint: CheckpointStore.CheckpointStore["Service"]["captureCheckpoint"] = (
+      input,
+    ) =>
+      Effect.gen(function* () {
+        yield* git.captureCheckpoint(input);
+        const workspace = workspaceOf(input.cwd);
+        if (workspace === null) {
+          return;
+        }
+        const env = fernEnvironmentId(workspace);
+        if (!created.has(env)) {
+          // The first checkpoint adopts the worktree: Fern turns it into a snapshottable volume.
+          yield* fern("FernCheckpointStore.create", input.cwd, [
+            "create",
+            "--path",
+            workspace,
+            env,
+          ]);
+          created.add(env);
+        }
+        // T3 reuses ordinals after a revert, so a snapshot of the same ref is taken again.
+        yield* fern("FernCheckpointStore.snapshot", input.cwd, [
+          "snapshot",
+          "--replace",
+          env,
+          fernSnapshotId(input.checkpointRef),
+        ]);
+      });
+
+    const restoreCheckpoint: CheckpointStore.CheckpointStore["Service"]["restoreCheckpoint"] = (
+      input,
+    ) =>
+      Effect.gen(function* () {
+        const workspace = workspaceOf(input.cwd);
+        const ref = { cwd: input.cwd, checkpointRef: input.checkpointRef };
+        if (workspace !== null && (yield* git.hasCheckpointRef(ref))) {
+          // Fern first: git's restore then fixes the index, which lives in the main repository.
+          yield* fern("FernCheckpointStore.restore", input.cwd, [
+            "restore",
+            fernEnvironmentId(workspace),
+            fernSnapshotId(input.checkpointRef),
+          ]);
+        }
+        return yield* git.restoreCheckpoint(input);
+      });
+
+    const deleteCheckpointRefs: CheckpointStore.CheckpointStore["Service"]["deleteCheckpointRefs"] =
+      (input) =>
+        Effect.gen(function* () {
+          yield* git.deleteCheckpointRefs(input);
+          const workspace = workspaceOf(input.cwd);
+          if (workspace === null || input.checkpointRefs.length === 0) {
+            return;
+          }
+          const found = yield* fern(
+            "FernCheckpointStore.which",
+            input.cwd,
+            ["which", workspace],
+            true,
+          );
+          // No environment means no checkpoint here was captured. If the daemon is down, the
+          // snapshots stay until T3 reuses their ordinals; that only costs disk.
+          if (found.exitCode !== 0) {
+            return;
+          }
+          yield* fern("FernCheckpointStore.rmsnap", input.cwd, [
+            "rmsnap",
+            found.stdout.trim(),
+            ...input.checkpointRefs.map(fernSnapshotId),
+          ]);
+        });
+
+    return CheckpointStore.CheckpointStore.of({
+      ...git,
+      captureCheckpoint,
+      restoreCheckpoint,
+      deleteCheckpointRefs,
+    });
+  });
+
+/** Wraps T3's git checkpoints with Fern's when FERN_POOL is set. */
+export const layer = Layer.effect(
+  CheckpointStore.CheckpointStore,
+  Effect.suspend(() => {
+    const pool = process.env.FERN_POOL?.trim();
+    return pool ? make({ pool, command: "fern" }) : CheckpointStore.make;
+  }),
+);

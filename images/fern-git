#!/bin/sh
# fern-git is `git` for T3's server on Fern: on its PATH, and in the folder
# git finds its own programs in (GIT_EXEC_PATH, set in fern-t3.service), so
# that every git T3 starts and every git that git starts comes through here.
# It runs the real git, except in one case: a repository whose git folder is
# in a thread's own folder, which the thread's box can write.
#
# T3 runs git in every worktree, as the user that owns it. A worktree's own
# git folder is in its repository (repos/, projects/), which a box gets
# read-only, so nothing a box writes is git's config there. But a box can
# make a repository in a folder of its worktree, config and all, and git
# opens it by itself: once the index holds the folder as a submodule (a
# repository with submodules; or after any `git add --all`), git status, git
# diff, git add, git commit -a, git stash and git fetch each start a git in
# it, and that git runs the programs its config names: a filter, an ssh
# command. That was the box's program in T3's service, with every worktree
# and the daemon's socket (found 2026-11-13). No setting of git's stops it: a
# .gitmodules in the worktree undoes diff.ignoreSubmodules, git add ignores
# it, and git's check of who owns a repository isn't made for a submodule.
#
# So no git here opens a repository in a box's reach. The git that git
# starts for a submodule is told its repository as GIT_DIR=.git or GIT_DIR=.:
# refused quietly, which git reads as "nothing changed there" and goes on.
# Any other call is refused out loud. A submodule that git itself set up
# keeps its git folder in the repository's (.git/modules), which no box
# writes, and works as ever.
set -u
real=${FERN_REAL_GIT:-/usr/lib/git-core/git}
pool=${FERN_POOL:-/var/lib/fern}

# opened prints the git folder this call would open, resolved, or nothing if
# there is none to find: $GIT_DIR, or the nearest .git above the folder the
# call runs in (after its leading -C options), followed if it is a file that
# names the folder.
opened() {
	while [ "${1:-}" = -C ] && [ $# -ge 2 ]; do
		cd "$2" 2>/dev/null || return 0
		shift 2
	done
	d=${GIT_DIR:-}
	if [ -z "$d" ]; then
		p=$(pwd -P)
		while [ ! -e "$p/.git" ]; do
			[ -n "$p" ] || return 0
			p=${p%/*}
		done
		d=$p/.git
	fi
	case $d in
	/*) ;;
	*) d=$(pwd -P)/$d ;;
	esac
	if [ -f "$d" ]; then
		IFS= read -r line <"$d" || true
		to=${line#gitdir: }
		case $to in
		/*) d=$to ;;
		*) d=${d%/*}/$to ;;
		esac
	fi
	(cd "$d" 2>/dev/null && pwd -P) || true
}

case $(opened "$@") in
"$pool"/worktrees/* | "$pool"/envs/*)
	case ${GIT_DIR:-} in
	.git | .) exit 0 ;;
	esac
	echo "fern-git: not opening the repository in $(pwd -P): its git folder is in a thread's own folder, which the thread's box writes." \
		"Git on this server opens only repositories whose git folder is in repos/ or projects/." >&2
	exit 128
	;;
esac
exec "$real" "$@"

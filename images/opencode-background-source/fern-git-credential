#!/usr/local/bin/node
const fs = require('node:fs');
const credentials = require('/usr/local/libexec/fern-github-credentials.cjs');

// store/erase are intentionally no-ops: never persist credentials from Git.
if (process.argv.length !== 3 || process.argv[2] !== 'get') process.exit(0);
try {
  const input = fs.readFileSync(0, 'utf8');
  if (input.length > 16384 || input.includes('\r') || input.includes('\0')) process.exit(0);
  const fields = new Map();
  for (const line of input.split('\n')) {
    if (!line) break;
    const separator = line.indexOf('=');
    if (separator < 1) process.exit(0);
    const key = line.slice(0, separator);
    if (fields.has(key)) process.exit(0);
    fields.set(key, line.slice(separator + 1));
  }
  const repo = credentials.repository();
  if (!repo || fields.get('protocol') !== 'https' || fields.get('host') !== 'github.com'
      || ![repo, `${repo}.git`].includes(fields.get('path'))) process.exit(0);
  const token = credentials.token();
  if (token) process.stdout.write(`username=x-access-token\npassword=${token}\n\n`);
} catch {
  // Missing, malformed, or inaccessible credentials must never leak diagnostics.
}

#!/bin/sh
# fern-claude is `claude` on the PATH of Fern's T3 image, so T3 runs it. In a
# Fern workspace it runs Claude in that environment's box, in the same
# directory, so T3, the box and Claude's transcripts all name files the same
# way. Anywhere else (T3's version checks and probes) it runs the local
# Claude: $FERN_LOCAL_CLAUDE, by default where the T3 image keeps it. In the
# pool's worktrees it never does: there an agent must not run in T3's own pod,
# with its login, the whole pool and the daemon's socket, just because the
# daemon didn't answer or the environment wasn't made.
#
# Only the variables Claude's SDK sets are passed on: T3's own environment,
# and any credentials in it, stays out of the box, which gets its login from
# the environment. fern exec passes SIGTERM on to Claude, so it can save its
# transcript, and exits when the box goes away.
set -eu
case "$PWD/" in
"${FERN_POOL:-/var/lib/fern}"/worktrees/*)
	# --here does the lookup itself and fails if the environment is missing.
	# A preliminary `which` would add a process and repeat the same request.
	;;
*)
	if ! fern which "$PWD" >/dev/null 2>&1; then
		exec "${FERN_LOCAL_CLAUDE:-/usr/local/libexec/claude}" "$@"
	fi
	;;
esac
exec fern exec -i --here -e CLAUDE_CODE_ENTRYPOINT -e CLAUDE_AGENT_SDK_VERSION -- claude "$@"

#!/bin/sh
# box-opencode is `opencode` in a box. In an agent box, which has Claude's
# folder, it keeps OpenCode's database and settings there, outside the
# workspace, so a restore doesn't rewind them and a sleep doesn't lose them,
# and once per environment it chooses Claude's login (OpenCode's Claude Agent
# provider, which runs the `claude` here; OpenCode never reads the login).
#
# OpenCode ignores the workspace's own OpenCode settings: the box writes
# those, and they would run code here, next to Claude's login. Both names of
# the variable are set: OpenCode 2.2.6 reads OPENCODE_CONFIG_PROJECT_DISABLE
# first, and an empty one there undoes the older name. For its server the
# daemon sets them too, with the rest of what keeps the workspace's programs
# out (internal/tools, openCode). The root filesystem is read-only, so it
# must not update itself.
set -eu
real=/usr/local/libexec/opencode
[ -n "${CLAUDE_CONFIG_DIR:-}" ] || exec "$real" "$@"
dir=$CLAUDE_CONFIG_DIR/opencode
export XDG_DATA_HOME="$dir/data" XDG_CONFIG_HOME="$dir/config" XDG_STATE_HOME="$dir/state" XDG_CACHE_HOME="$dir/cache" \
	OPENCODE_CONFIG_PROJECT_DISABLE=1 OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_DISABLE_AUTOUPDATE=1
if [ ! -e "$dir/claude-agent" ]; then
	mkdir -p "$dir"
	# --standalone: with a server of its own, which ends with the command.
	if "$real" auth login claude-agent --standalone >/dev/null 2>&1; then
		: >"$dir/claude-agent"
	fi
fi
# Fern's hint, which fern-init writes for Claude at every start, is OpenCode's
# own instructions too, unless someone wrote their own there.
hint=$dir/config/opencode/AGENTS.md
if [ -L "$hint" ] || [ ! -e "$hint" ]; then
	mkdir -p "$dir/config/opencode"
	ln -sf "$CLAUDE_CONFIG_DIR/CLAUDE.md" "$hint"
fi
exec "$real" "$@"

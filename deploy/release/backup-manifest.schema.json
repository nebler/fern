{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fern.invalid/schemas/backup-manifest-v2.json",
  "title": "Fern host backup manifest (MANIFEST.json inside the age-encrypted archive)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "created_at", "workspace", "files"],
  "properties": {
    "format": {"const": "fern-backup-v2"},
    "created_at": {"type": "string", "format": "date-time"},
    "workspace": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(state/.+|config/fern\\.yaml|config/fern\\.env)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fern.invalid/schemas/transaction-manifest-v1.json",
  "title": "Fern host backup, restore, and rollback transaction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "operation", "phase", "appliance_epoch", "generation", "backup", "activation", "rollback", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "operation": {"enum": ["backup", "restore", "rollback"]},
    "phase": {"enum": ["planned", "locked", "verified", "staged", "activated", "rolled-back", "failed"]},
    "appliance_epoch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "generation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "manifest", "checksum_file", "credential_policy", "named_volumes"],
      "properties": {
        "format": {"const": "fern-host-backup-v1"},
        "manifest": {"const": "BACKUP-MANIFEST.json"},
        "checksum_file": {"const": "SHA256SUMS"},
        "credential_policy": {"enum": ["exclude", "external"]},
        "named_volumes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "epoch_marker", "current_generation"],
      "properties": {
        "model": {"const": "staged-current-previous"},
        "epoch_marker": {"const": ".fern-appliance-epoch"},
        "current_generation": {"type": "string", "minLength": 1}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "previous_generation"],
      "properties": {
        "available": {"type": "boolean"},
        "previous_generation": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_path", "sha256sums_path"],
      "properties": {
        "bundle_path": {"type": "string", "minLength": 1},
        "sha256sums_path": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"rollback": {"properties": {"available": {"const": false}}}}},
      "then": {"properties": {"rollback": {"properties": {"previous_generation": {"type": "null"}}}}}
    },
    {
      "if": {"properties": {"rollback": {"properties": {"available": {"const": true}}}}},
      "then": {"properties": {"rollback": {"properties": {"previous_generation": {"type": "string", "minLength": 1}}}}}
    }
  ]
}

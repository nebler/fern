{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fern.invalid/schemas/compatibility-manifest-v1.json",
  "title": "Fern durable schema compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "first_supported_baseline", "current_release_schemas", "verification", "limitations"],
  "properties": {
    "$schema": {"const": "./compatibility-manifest.schema.json"},
    "schema_version": {"const": 1},
    "first_supported_baseline": {
      "type": "null"
    },
    "current_release_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_store", "control_state", "github_app_credentials"],
      "properties": {
        "task_store": {"const": 1},
        "control_state": {"const": 1},
        "github_app_credentials": {"const": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh_schema_test", "upgrade_harness", "rollback_prerequisite"],
      "properties": {
        "fresh_schema_test": {"const": "internal/compatibility/compatibility_test.go"},
        "upgrade_harness": {"const": "integration/upgrade/run.sh"},
        "rollback_prerequisite": {"const": "verified-offline-pre-upgrade-backup"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

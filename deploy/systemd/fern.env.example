# Install as /etc/fern/fern.env with mode 0640 and owner root:fern.
# EnvironmentFile values are not shell-expanded. Quote values containing spaces.
OPENCODE_PASSWORD=replace-with-a-long-random-value
FERN_CONTROL_PASSWORD=replace-with-a-different-long-random-value

# Set only the providers used by this workspace.
ANTHROPIC_API_KEY=replace-me
# OPENAI_API_KEY=replace-me

workspace:
  name: demo
  repo: /srv/fern/repository
  github:
    mode: github-app-broker
    hostname: github.com
    installationId: 12345678
    repository:
      id: 123456789
      fullName: owner/repository
tasks:
  # Operator-provisioned Linux XFS project quota; never durable DB/CAS storage.
  runtimeStorageRoot: /var/lib/fern-runtime
  agent: build
  model:
    provider: replace-with-provider-id
    id: replace-with-model-id
  attemptTimeout: 30m
  backgroundImage: ghcr.io/owner/fern/opencode-background-source@sha256:REPLACE_WITH_64_LOWERCASE_HEX_DIGITS
  backgroundImageID: sha256:REPLACE_WITH_64_LOWERCASE_HEX_DIGITS
  backgroundRoute:
    listen: 127.0.0.1:8443
    origin: https://replace-with-this-host.example.ts.net:8443
control:
  password: ${FERN_CONTROL_PASSWORD}
proxy:
  listen: 127.0.0.1:8080
  operatorListen: 127.0.0.1:8081
  remoteOrigin: https://replace-with-this-host.example.ts.net

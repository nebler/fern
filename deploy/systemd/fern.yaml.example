workspace:
  name: demo
  # Replace SOURCE_COMMIT with the exact trusted Fern source commit used to build it.
  image: fern/opencode:SOURCE_COMMIT
  repo: /srv/fern/workspace
  memory: 8Gi
  env:
    OPENCODE_PASSWORD: ${OPENCODE_PASSWORD}
idle:
  after: 10m
proxy:
  # Tailscale Serve terminates tailnet TLS and proxies to this loopback listener.
  listen: 127.0.0.1:8080

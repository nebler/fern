[Unit]
Description=Fern disposable Background Run control plane
Documentation=file:/opt/fern/src/ARCHITECTURE.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=fern
Group=fern
SupplementaryGroups=docker
WorkingDirectory=/var/lib/fern
Environment=HOME=/var/lib/fern
EnvironmentFile=/etc/fern/fern.env
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ExecStart=/usr/local/bin/fern up --config /etc/fern/fern.yaml --env-file /etc/fern/fern.env --listen 127.0.0.1:8080 --operator-listen 127.0.0.1:8081
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

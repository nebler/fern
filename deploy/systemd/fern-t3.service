# T3 Code's server on a Fern node, run from its image's root (fern image
# load fern-t3:dev) as the box user, which owns T3's folders in the pool.
# It reaches the daemon at /run/fern/fern.sock, serves on port 30773 (the
# port it had as a NodePort, which the lab's scripts and tunnels use), and
# gets Claude's login from /etc/fern/claude.env for the Claude it runs
# outside environments. It listens on every address: a firewall must keep
# the port from the internet (lab/vps.sh installs one that lets in only
# SSH); reach it through an SSH tunnel or a private network.
[Unit]
Description=T3 Code's server, on Fern
After=fern-daemon.service
Wants=fern-daemon.service
RequiresMountsFor=/var/lib/fern
# A failure systemd gives up on reaches the owner (fern-failed@.service).
OnFailure=fern-failed@%n.service

[Service]
User=1000
Group=1000
RootDirectory=/var/lib/fern/images/fern-t3:dev/root
BindPaths=/var/lib/fern /run/fern
BindReadOnlyPaths=/etc/resolv.conf /etc/hosts
# The image's root is read-only for it; T3 writes only to the pool.
ProtectSystem=strict
ReadWritePaths=/var/lib/fern /run/fern
# But not all of the pool: the environments' records, snapshots and Claude
# folders, the images and the boxes' own files are the daemon's, and T3
# asks it for what it needs of them (the socket). T3 runs as the user that
# owns the Claude folders, and a line planted in one would run in that
# thread's agent box, with its login. It still reads them. The + reads the
# path inside the service's root, where the pool is bound: without it the
# line names the node's own path, and changes nothing T3 sees.
ReadOnlyPaths=-+/var/lib/fern/envs -+/var/lib/fern/images -+/var/lib/fern/boxes
PrivateTmp=yes
# It starts nothing with more rights than it has, and has no use for the
# kernel's settings.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
WorkingDirectory=/opt/t3
# T3's home is the pool, so its worktrees (<home>/worktrees) are where Fern
# expects workspaces; FERN_POOL is the checkpoint hook's. The user's home is
# projects/: T3 clones a repository from GitHub into its home, and there a
# clone outlives an update (the image's /home/node doesn't), its worktrees'
# boxes get its git folder (internal/store), and backups take it.
Environment=HOME=/var/lib/fern/projects T3CODE_HOME=/var/lib/fern FERN_POOL=/var/lib/fern FERN_TIMING=1 DISABLE_AUTOUPDATER=1
EnvironmentFile=-/etc/fern/claude.env
# git's credential helper for github.com: a token for the one repository,
# from the daemon's GitHub App (fern git-credential), if there is one.
Environment=GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_0=credential.https://github.com.helper "GIT_CONFIG_VALUE_0=!/usr/local/bin/fern git-credential" GIT_CONFIG_KEY_1=credential.https://github.com.useHttpPath GIT_CONFIG_VALUE_1=true GIT_CONFIG_KEY_2=safe.bareRepository GIT_CONFIG_VALUE_2=explicit
# Every git T3 starts, and every git that git starts, is fern-git
# (cmd/fern-git): in a thread's folder it opens the worktree's own
# repository and no other, so never one whose config the thread's box wrote.
# Nor does git take a folder there for a bare repository (the setting above).
Environment=GIT_EXEC_PATH=/usr/local/libexec/fern-git-core
# T3's folders in the pool, owned by its user (on the node: + runs it
# outside the image), then Fern's defaults for its settings.
ExecStartPre=+/usr/bin/install -d -o 1000 -g 1000 /var/lib/fern/userdata /var/lib/fern/caches \
  /var/lib/fern/tools /var/lib/fern/repos /var/lib/fern/projects /var/lib/fern/worktrees
ExecStartPre=/usr/local/bin/node /opt/fern/t3-settings.js
ExecStart=/usr/local/bin/node /opt/t3/apps/server/dist/bin.mjs serve --host=0.0.0.0 --port=30773
Restart=always
RestartSec=1
# Its disk writes, which lab/perf.sh measures, as a pod's were.
IOAccounting=yes

[Install]
WantedBy=multi-user.target
